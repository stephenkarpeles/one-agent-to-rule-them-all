# Cursor user API key or team service-account key.
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional. Defaults to composer-2.5.
CURSOR_MODEL=composer-2.5

# Optional. Absolute path to ripgrep. The agent finds Cursor's copy when this is empty.
CURSOR_RIPGREP_PATH=

# Vercel access token with deploy and analytics access.
# https://vercel.com/account/tokens
VERCEL_TOKEN=

# Set one of these when the project lives on a team. Leave both empty for a personal account.
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# Optional. Slack-compatible incoming webhook. The report is POSTed as {"text": "..."}.
MARKETING_WEBHOOK_URL=
